# numba#10610: the test_reproducible_build_* AOT nondeterminism checks are
# expectedFailure upstream. On ppc64le they pass intermittently
# (recursive_type on PR #213, stencil on PR #218), and an unexpected success
# fails the suite. Applies after skip-test_compile_nrt-on-ppc64le.patch,
# which defines _NUMBA_CF_PPC64LE. Retire when numba#10610 closes.
--- a/numba/tests/test_pycc.py
+++ b/numba/tests/test_pycc.py
@@ -348,6 +348,10 @@
         self.assertEqual(h1, h2,
                          "AOT binary is not reproducible across builds")

+    @unittest.skipIf(
+        _NUMBA_CF_PPC64LE,
+        "numba#10610: nondeterministic on ppc64le, can pass unexpectedly",
+    )
     @unittest.expectedFailure
     @skip_if_windows
     def test_reproducible_build_jitclass(self):
@@ -387,6 +391,10 @@
         self.assertEqual(h1, h2,
                          "AOT jitclass binary is not reproducible")

+    @unittest.skipIf(
+        _NUMBA_CF_PPC64LE,
+        "numba#10610: nondeterministic on ppc64le, can pass unexpectedly",
+    )
     @unittest.expectedFailure
     @skip_if_windows
     def test_reproducible_build_recursive_type(self):
@@ -441,6 +449,10 @@
         self.assertEqual(h1, h2,
                          "AOT recursive-type binary is not reproducible")

+    @unittest.skipIf(
+        _NUMBA_CF_PPC64LE,
+        "numba#10610: nondeterministic on ppc64le, can pass unexpectedly",
+    )
     @unittest.expectedFailure
     @skip_if_windows
     def test_reproducible_build_stencil(self):
@@ -476,6 +488,10 @@
         self.assertEqual(h1, h2,
                          "AOT stencil binary is not reproducible")

+    @unittest.skipIf(
+        _NUMBA_CF_PPC64LE,
+        "numba#10610: nondeterministic on ppc64le, can pass unexpectedly",
+    )
     @skip_if_windows
     @unittest.expectedFailure
     def test_reproducible_build_set_iteration_order(self):
